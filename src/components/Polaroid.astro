---
// A taped-on instant photo. Pass `src` once there's a photo in /public; until then it shows a placeholder.
interface Props {
  src?: string;
  alt?: string;
  caption: string;
  tilt?: number;
  size?: 'large' | 'small';
}

const { src, alt = 'Alex Ainsworth', caption, tilt = 3, size = 'large' } = Astro.props;
---

<figure class:list={['polaroid', size]} style={`--tilt: ${tilt}deg`}>
  <span class="tape" aria-hidden="true"></span>
  {
    src ? (
      <img src={src} alt={alt} width="600" height="700" loading="eager" decoding="async" />
    ) : (
      <div class="placeholder" role="img" aria-label="Photo coming soon">
        <span>photo incoming</span>
      </div>
    )
  }
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .polaroid {
    position: relative;
    margin: 0;
    background: #fff;
    padding: 0.85rem 0.85rem 0;
    border: 1px solid #c9d3e3;
    box-shadow: 0 18px 30px -18px rgba(20, 33, 61, 0.55);
    transform: rotate(var(--tilt));
    width: 100%;
  }

  .polaroid.large {
    max-width: 22rem;
  }

  .polaroid.small {
    max-width: 15rem;
  }

  .tape {
    position: absolute;
    top: -0.9rem;
    left: 50%;
    width: 6.5rem;
    height: 1.8rem;
    transform: translateX(-50%) rotate(-4deg);
    background: rgba(255, 233, 122, 0.75);
    border-left: 1px dashed rgba(20, 33, 61, 0.15);
    border-right: 1px dashed rgba(20, 33, 61, 0.15);
  }

  img,
  .placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 6 / 7;
    object-fit: cover;
    background: #dfe6f0;
  }

  .placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      repeating-linear-gradient(45deg, #e6ecf4 0 12px, #dbe3ee 12px 24px);
  }

  .placeholder span {
    font-family: var(--font-hand);
    font-size: 1.75rem;
    color: var(--ink-soft);
  }

  figcaption {
    font-family: var(--font-hand);
    color: var(--ink);
    font-size: 1.6rem;
    line-height: 1.1;
    text-align: center;
    padding: 0.75rem 0.5rem 1rem;
  }

  .small figcaption {
    font-size: 1.35rem;
  }
</style>
