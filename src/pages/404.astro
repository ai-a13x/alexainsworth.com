---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="hero">
    <div class="wrap">
      <span class="mono">404</span>
      <h1 class="title">Nothing here.</h1>
      <p class="lede">There's nothing at this address. Try the <a href={u("/")}>home page</a> or the <a href={u("/writing/")}>writing</a>.</p>
    </div>
  </section>
</Base>

<style>
  .title {
    margin: 1rem 0 1.5rem;
  }
</style>
