---
import { u } from '../lib/url';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base>
  <section class="hero">
    <div class="wrap">
      <h1>I build consumer products people love.</h1>
      <div class="split lede">
        <p>Product Lead at Slingshot AI, working on Ash, an AI built for mental health.</p>
        <p>Before that I led product at Runna and was the first PM at Cleo AI, with a year of scuba diving in between.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="stats">
        <div class="stat">
          <span class="mono">Runna · 2024 to 2026</span>
          <b>100k <span class="accent">→</span> 1m+</b>
          <p>subscribers. Second PM in, Head of Product out. Acquired by Strava.</p>
        </div>
        <div class="stat">
          <span class="mono">Cleo AI · 2019 to 2022</span>
          <b>$400m<span class="accent">+</span></b>
          <p>ARR business on the subscription product I built as first PM.</p>
        </div>
        <div class="stat">
          <span class="mono">Utila · 2022 to 2023</span>
          <b>0</b>
          <p>divers lost in a year as a scuba instructor. Hundreds certified.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Where I've worked</h2>
        <a class="mono" href={u('/about/')}>Full history →</a>
      </div>
      <ul class="rows">
        <li class="row">
          <span class="mono">2026 to now</span>
          <h3>Slingshot AI</h3>
          <p>Product Lead on Ash. Getting people from curious to coming back every day.</p>
          <span class="tag">Now</span>
        </li>
        <li class="row">
          <span class="mono">2024 to 2026</span>
          <h3>Runna</h3>
          <p>Second PM in, Head of Product out. 100k to over a million subscribers.</p>
          <span class="tag">Acquired by Strava</span>
        </li>
        <li class="row">
          <span class="mono">2022 to 2023</span>
          <h3>Utila, Honduras</h3>
          <p>Eighteen months travelling, a year of it as a scuba instructor.</p>
          <span class="tag">Sabbatical</span>
        </li>
        <li class="row">
          <span class="mono">2019 to 2022</span>
          <h3>Cleo AI</h3>
          <p>First PM. Built the subscription product behind a $400m+ ARR business.</p>
          <span class="tag">First PM</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Hackathon wins</h2>
        <span class="mono">Two from two, not that I'm counting</span>
      </div>
      <div class="panels">
        <article class="panel">
          <span class="mono">Strava hackathon · <span class="accent">Winner</span></span>
          <h3>A running coach that listens back</h3>
          <p>Dynamic audio coaching that paces you to a 5K PB, using on-device LLMs that react to how your run is actually going rather than reading out a script.</p>
        </article>
        <article class="panel">
          <span class="mono">Slingshot AI hackathon · <span class="accent">Winner</span></span>
          <h3>Therapists as a growth channel</h3>
          <p>A referral programme that gets licensed therapists recommending Ash to their clients, turning the people closest to the problem into the best way in.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Latest writing</h2>
        <a class="mono" href={u('/writing/')}>All writing →</a>
      </div>
      <ul class="rows">
        {posts.map((post) => (
          <li class="post-row">
            <time class="mono" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <div>
              <a href={u(`/writing/${post.id}/`)}>{post.data.title}</a>
              <p>{post.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
