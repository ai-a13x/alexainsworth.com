---
import { u } from '../../lib/url';
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="Writing" description="Alex Ainsworth on the changing product job, startups, management, and building with AI.">
  <section class="hero">
    <div class="wrap">
      <span class="mono">Thinking out loud, mostly about product</span>
      <h1 class="title">Writing</h1>
      <p class="lede narrow">
        How the PM job is changing, being a PM in a startup, what good management looks like, and the AI systems I build to make the work easier. Follow along by <a href={u("/rss.xml")}>RSS</a> or on <a href="https://www.linkedin.com/in/alex-ainsworth-product/">LinkedIn</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>All posts</h2>
        <span class="mono">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
      </div>
      <ul class="rows">
        {posts.map((post) => (
          <li class="post-row">
            <time class="mono" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
            <div>
              <a href={u(`/writing/${post.id}/`)}>{post.data.title}</a>
              <p>{post.data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .title {
    margin: 1rem 0 1.75rem;
  }
</style>
